              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(body.token.split('.')).to.have.length(3));",
                  "pm.test('expiresIn is 3600', () => pm.expect(body.expiresIn).to.eql(3600));",
                  "const claims = JSON.parse(atob(body.token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "pm.test('groups claim contains USER', () => pm.expect(claims.groups).to.include('USER'));",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "response": [
