{
  "info": {
    "_postman_id": "6f1c2d3e-4a5b-4c6d-8e9f-0a1b2c3d4e5f",
    "name": "Expense Tracker (Quarkus)",
    "description": "Run top to bottom (Collection Runner or `newman run`). Register creates a unique username; login stores the JWT in the `token` collection variable. Everything goes through the gateway (:8080) except the 'direct' and metrics requests (expense-service :8082).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth (via Gateway, public)",
      "item": [
        {
          "name": "Register user (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique username per run so the collection can be re-run",
                  "pm.collectionVariables.set('username', `priya${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('returns the user without password', () => { const b = pm.response.json(); pm.expect(b.username).to.eql(pm.collectionVariables.get('username')); pm.expect(b).to.not.have.property('password'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate (409)",
          "request": {
