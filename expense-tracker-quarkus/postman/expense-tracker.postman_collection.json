    {
      "name": "Expense Service (direct, independent JWT check)",
      "description": "Calls expense-service on port 8080 directly (bypassing the gateway) to show it verifies JWT signatures itself. Port 8080 is only bound to localhost in docker-compose.",
      "item": [
        {
          "name": "Direct: valid JWT (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{expenseServiceUrl}}/api/expenses",
              "host": [
                "{{expenseServiceUrl}}"
              ],
              "path": [
                "api",
                "expenses"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Direct: forged JWT (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{expenseServiceUrl}}/api/expenses",
              "host": [
                "{{expenseServiceUrl}}"
              ],
              "path": [
                "api",
                "expenses"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Re-sign nothing: take the real token and swap in a forged payload. The signature no longer matches.",
                  "const [h, p, s] = pm.collectionVariables.get('token').split('.');",
                  "const claims = JSON.parse(atob(p.replace(/-/g,'+').replace(/_/g,'/')));",
                  "claims.sub = '1'; claims.groups = ['ADMIN','USER'];",
                  "const forged = btoa(JSON.stringify(claims)).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                  "pm.request.headers.upsert({key: 'Authorization', value: `Bearer ${h}.${forged}.${s}`});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
