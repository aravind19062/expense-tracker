        {
          "name": "Login (saves JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().token; pm.test('has token', () => pm.expect(t).to.be.a('string'));",
                  "pm.collectionVariables.set('token', t);",
                  "pm.test('upn = username, groups = [user]', () => { const c = JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(c.upn).to.eql(pm.collectionVariables.get('username')); pm.expect(c.groups).to.eql(['user']); });"
                ]
              }
            }
          ]
        }
      ]
    },
